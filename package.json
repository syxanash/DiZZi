{
  "name": "dizzi2",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev-start": "concurrently \"npm run dev\" \"npm run backend-start\"",
    "prod-start": "npm run build && concurrently \"npm run preview\" \"npm run backend-start\"",
    "backend-start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local backend/server.js",
    "dev": "vite --host",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "computer.simone.dizzi",
    "productName": "Dizzi",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**",
      "backend/**",
      "electron/**",
      "!backend/llm.js",
      "!node_modules/ollama/**",
      "!node_modules/openai/**"
    ],
    "asarUnpack": [
      "backend/public/audio/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "syxanash",
      "repo": "dizzi"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null,
      "extendInfo": {
        "NSBluetoothAlwaysUsageDescription": "Dizzi connects to your Beyblade launcher."
      }
    },
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "express": "^5.2.1",
    "lodash": "^4.18.1",
    "ollama": "^0.6.4",
    "openai": "^7.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
